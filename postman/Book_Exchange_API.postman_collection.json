{
  "info": {
    "name": "Book Exchange API",
    "description": "Manual API testing collection for the Book Exchange API. The automated JUnit/RestAssured suite is the regression source of truth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userEmail",
      "value": "api-user@example.com"
    },
    {
      "key": "userPassword",
      "value": "Password123!"
    },
    {
      "key": "adminEmail",
      "value": "api-admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "Password123!"
    },
    {
      "key": "recipientEmail",
      "value": "api-recipient@example.com"
    },
    {
      "key": "bookTitle",
      "value": "Effective Java API Test"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"authority\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Registers a normal user."
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"authority\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Registers an admin. This mirrors current API behavior, but public admin registration is documented as a security concern."
          }
        },
        {
          "name": "Register Validation Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"password\": \"\",\n  \"authority\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Verify Basic Auth",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{userEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{userPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owned",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owned"
              ]
            },
            "description": "The current API has no /login endpoint, so Basic Auth is verified through /owned."
          }
        }
      ]
    },
